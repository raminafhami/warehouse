# Copy to .env. Keep real values local.
# Used by npm run dev:api, migrate and seed when a native replica set is available.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
# First startup only. Use a private password with at least 12 characters.
REVAL_ADMIN_USERNAME=
REVAL_ADMIN_PASSWORD=
# Set APP_ORIGIN to http://127.0.0.1:8080 when using Docker Compose.
SESSION_TTL_SECONDS=28800
MONGODB_URI=mongodb://127.0.0.1:27017/reval_dev?replicaSet=rs0
ALLOW_DEMO_SEED=false

# Generate two distinct private passwords with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))".
MONGO_ROOT_PASSWORD=
MONGO_PASSWORD=
WEB_PORT=8080
# Staging only. Override APP_ORIGIN with the approved HTTPS origin.
# REVAL_IMAGE_PREFIX=reval-staging
# REVAL_IMAGE_TAG=<release-commit>
