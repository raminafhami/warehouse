{
  "name": "reval",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "npm run dev --workspace @reval/web",
    "dev:api": "npm run dev --workspace @reval/api",
    "lint": "eslint .",
    "format:check": "prettier --check package.json jsconfig.json eslint.config.js \"apps/**/*.{js,jsx,json,css,html}\" \"docker/*.js\" \"compose*.yaml\" \"../.github/workflows/*.yml\"",
    "typecheck": "tsc --project jsconfig.json",
    "build": "npm run build --workspaces",
    "test": "node --test apps/api/test/*.test.js",
    "test:integration": "node --test apps/api/test/*.integration.js",
    "migrate": "npm run migrate --workspace @reval/api",
    "seed": "npm run seed --workspace @reval/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  }
}
