{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["apps/api/src/**/*.js", "apps/web/src/**/*"],
  "exclude": ["node_modules"]
}
