    "/material-deliveries/{id}/receipts": {
      "post": {
        "operationId": "recordDeliveryReceipt",
        "summary": "دریافت حواله در خط",
        "tags": [
          "Materials"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
