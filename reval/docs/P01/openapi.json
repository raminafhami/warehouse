{
  "openapi": "3.0.3",
  "info": {
    "title": "REVAL API — طرح اولیهٔ موجودی",
    "version": "0.1.0",
    "description": "پیش‌نویس قرارداد P01. شامل مسیرهای اولیهٔ دریافت، رزرو و حواله برای بررسی G1."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/shipments/{id}/receipts": {
      "post": {
        "operationId": "recordShipmentReceipt",
        "summary": "ثبت دریافت محموله",
        "tags": [
          "Shipments"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShipmentReceiptCommand"
              },
              "example": {
                "version": 0,
                "acceptedLines": [
                  {
                    "cartonId": "507f1f77bcf86cd799439011",
                    "quantity": "4"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "فرمان ثبت شد یا پاسخ قبلی بازیابی شد.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResponse"
                }
              }
            }
          },
          "400": {
            "description": "ورودی نامعتبر.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "نشست نامعتبر.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "عملیات در محدودهٔ کاربر مجاز نیست.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "سند در محدودهٔ کاربر پیدا نشد.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "تعارض وضعیت، نسخه، کلید یا مقدار قابل تخصیص.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
