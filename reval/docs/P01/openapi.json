  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "reval_session",
        "description": "نشست سمت سرور. کوکی HttpOnly و در محیط TLS با Secure. اعتبارسنجی Origin برای درخواست‌های تغییردهنده."
      }
    },
    "schemas": {
      "Quantity": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
        "description": "سرویس برای هر اقدام، مثبت یا نامنفی بودن مقدار و گام واحد SKU را بررسی می‌کند.",
        "example": "4"
      },
      "CartonLine": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cartonId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "quantity": {
            "$ref": "#/components/schemas/Quantity"
          }
        },
        "required": [
          "cartonId",
          "quantity"
        ]
      },
      "ShipmentReceiptCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "acceptedLines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/CartonLine"
            }
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "version",
          "acceptedLines"
        ]
      },
      "ReservationCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/CartonLine"
            }
          }
        },
        "required": [
          "version",
          "lines"
        ]
      },
      "DeliveryIssueCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/CartonLine"
            }
          }
        },
        "required": [
          "version",
          "lines"
        ]
      },
      "DeliveryReceiptCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "acceptedLines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartonLine"
            }
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "version",
          "acceptedLines"
        ]
      },
      "CommandResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "documentId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "discrepancyId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        },
        "required": [
          "id",
          "documentId",
          "status",
          "version"
        ]
      },
      "CommandResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statusCode": {
            "type": "integer",
            "enum": [
              200
            ]
          },
          "message": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/CommandResult"
          }
        },
        "required": [
          "statusCode",
          "message",
          "result"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message",
          "code",
          "correlationId"
        ]
      }
    }
  }
}
